{
  "$schema": "../../schemas/extensions/orbit/manifest.v3.json",
  "schemaVersion": 3,
  "id": "example.dotnet-state",
  "name": ".NET state sample",
  "description": "Actions and a passive status for an on/off value kept only in this companion's memory. No other app or file is changed.",
  "version": "0.3.0",
  "hosts": ["orbit"],
  "disclosures": { "network": "None" },
  "contributions": [
    {
      "id": "example.dotnet-state/set-state",
      "name": "Set sample state",
      "description": "Sets the companion's in-memory value to the chosen state. The face shows the current state.",
      "glyph": "\uE7E8",
      "provides": ["invoke", "face"],
      "settings": [
        {
          "id": "mode",
          "kind": "Choice",
          "name": "When picked",
          "default": "on",
          "choices": [
            { "value": "on", "name": "Turn sample on" },
            { "value": "off", "name": "Turn sample off" }
          ]
        }
      ]
    },
    {
      "id": "example.dotnet-state/status",
      "name": "Sample status",
      "description": "Shows the companion's in-memory value. Picking it changes nothing.",
      "glyph": "\uE7E8",
      "provides": ["face"],
      "settings": [
        {
          "id": "display",
          "kind": "Choice",
          "name": "Show",
          "default": "words",
          "choices": [
            { "value": "words", "name": "On or Off" },
            { "value": "number", "name": "1 or 0" }
          ]
        }
      ]
    }
  ]
}
