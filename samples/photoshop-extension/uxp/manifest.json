{
  "manifestVersion": 5,
  "id": "example.photoshop-bridge",
  "name": "Photoshop bridge sample",
  "version": "0.3.0",
  "main": "index.html",
  "host": [{ "app": "PS", "minVersion": "25.0.0", "data": { "apiVersion": 2 } }],
  "entrypoints": [{
    "type": "panel",
    "id": "photoshopBridge",
    "label": { "default": "Photoshop bridge sample" },
    "minimumSize": { "width": 280, "height": 200 },
    "preferredDockedSize": { "width": 300, "height": 260 },
    "preferredFloatingSize": { "width": 340, "height": 260 }
  }],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": ["ws://localhost:38475"] }
  }
}
