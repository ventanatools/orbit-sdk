<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SupportedOSPlatformVersion />
    <TargetPlatformMinVersion />
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifiers />
    <RuntimeIdentifier />
    <Version>0.1.0-preview.2</Version>
    <PackageId>Orbit.Extensions.Sdk</PackageId>
    <Authors>Seth Cottle</Authors>
    <Description>Out-of-process .NET companion SDK for Orbit extension contributions.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ventanatools/orbit-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://dev.ventana.tools/orbit/</PackageProjectUrl>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orbit.Extensions.Protocol\Orbit.Extensions.Protocol.csproj" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
