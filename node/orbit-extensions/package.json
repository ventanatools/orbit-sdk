  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./wire": {
      "types": "./wire.d.ts",
      "default": "./wire.js"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "default": "./testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "wire.js",
    "wire.d.ts",
    "testing.js",
    "testing.d.ts",
    "lib/",
    "README.md",
    "LICENSE"
