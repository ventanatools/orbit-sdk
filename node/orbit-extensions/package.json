{
  "name": "@ventanatools/orbit-extensions",
  "version": "0.1.0-preview.1",
  "private": true,
  "description": "Node SDK for extension companions: manifests, pairing, the wire protocol, the companion client and a test kit.",
  "license": "Apache-2.0",
  "author": "Ventana Tools LLC",
  "homepage": "https://dev.ventana.tools/",
  "type": "commonjs",
  "main": "./index.js",
