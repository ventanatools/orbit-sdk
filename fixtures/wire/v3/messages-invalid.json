      "expect": "invoke.outcome-invalid"
    },
    {
      "name": "a failure with an outcome other than Failed",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"result\",\"requestId\":\"a0a1a2a3a4a5a6a7a8a9aaabacadaeaf\",\"outcome\":\"Done\",\"failure\":\"Network\"}",
