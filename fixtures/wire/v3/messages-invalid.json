    },
    {
      "name": "a null member",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"stopSession\",\"sessionId\":null}",
      "expect": "protocol.message-invalid"
    },
    {
      "name": "a null in an ignored member",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"ping\",\"id\":1,\"extra\":null}",
      "expect": "protocol.message-invalid"
    },
    {
      "name": "a null in hello",
      "sender": "Companion",
      "phase": "Handshake",
      "frame": "{\"type\":\"hello\",\"minVersion\":3,\"maxVersion\":3,\"registrationId\":\"00112233445566778899aabbccddeeff\",\"clientNonce\":\"QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE=\",\"capabilities\":[],\"client\":{\"name\":\"example-client\",\"version\":\"1.0.0\"},\"manifestHash\":\"1f7c38cf0bc0408b9b62e5d90fdc796c479fe791e7b54fdb701c82cedccb2e8f\",\"extra\":null}",
