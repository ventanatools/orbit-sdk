{
  "about": "Frames a receiver refuses, with the reason code it closes with. frameBase64 holds bytes that are not text; frameRepeat builds prefix, then fill repeated, then suffix, to exactly length bytes.",
  "cases": [
    {
      "name": "an empty frame",
      "sender": "Host",
      "phase": "Authenticated",
      "frameBase64": "",
      "expect": "frame.too-large"
    },
    {
      "name": "a frame over 65,536 bytes",
      "sender": "Host",
      "phase": "Authenticated",
      "frameRepeat": {
        "prefix": "{\"type\":\"ping\",\"id\":1,\"pad\":\"",
        "fill": "a",
        "suffix": "\"}",
        "length": 65537
      },
      "expect": "frame.too-large"
    },
    {
      "name": "a handshake frame over 8,192 bytes",
      "sender": "Companion",
      "phase": "Handshake",
      "frameRepeat": {
        "prefix": "{\"type\":\"hello\",\"minVersion\":3,\"maxVersion\":3,\"registrationId\":\"00112233445566778899aabbccddeeff\",\"clientNonce\":\"QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE=\",\"capabilities\":[],\"client\":{\"name\":\"example-client\",\"version\":\"1.0.0\"},\"manifestHash\":\"1f7c38cf0bc0408b9b62e5d90fdc796c479fe791e7b54fdb701c82cedccb2e8f\",\"pad\":\"",
        "fill": "a",
        "suffix": "\"}",
        "length": 8193
      },
      "expect": "frame.too-large"
    },
    {
      "name": "invalid UTF-8",
      "sender": "Host",
      "phase": "Authenticated",
      "frameBase64": "eyJ0eXBlIjoicGluZyIsImlkIjoxLCJ4Ijoi/yJ9",
      "expect": "frame.utf8-invalid"
    },
    {
      "name": "an overlong UTF-8 encoding",
      "sender": "Host",
      "phase": "Authenticated",
      "frameBase64": "eyJ0eXBlIjoicGluZyIsImlkIjoxLCJ4IjoiwK8ifQ==",
      "expect": "frame.utf8-invalid"
    },
    {
      "name": "not JSON",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "hello",
      "expect": "frame.json-invalid"
    },
    {
      "name": "an array root",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "[]",
      "expect": "frame.json-invalid"
    },
    {
      "name": "a string root",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "\"ping\"",
      "expect": "frame.json-invalid"
    },
    {
      "name": "trailing content",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"ping\",\"id\":1} {}",
      "expect": "frame.json-invalid"
    },
    {
      "name": "a trailing comma",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"ping\",\"id\":1,}",
      "expect": "frame.json-invalid"
    },
    {
      "name": "a comment",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"ping\",/* c */\"id\":1}",
      "expect": "frame.json-invalid"
    },
    {
      "name": "nesting deeper than 8",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"ping\",\"id\":1,\"x\":[[[[[[[[1]]]]]]]]}",
      "expect": "frame.json-invalid"
    },
    {
      "name": "an unpaired surrogate escape",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"ping\",\"id\":1,\"x\":\"\\ud800\"}",
      "expect": "frame.json-invalid"
    },
    {
      "name": "a duplicate member",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"ping\",\"id\":1,\"id\":2}",
      "expect": "frame.json-duplicate"
    },
    {
      "name": "a duplicate that differs only in escaping",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"ping\",\"id\":1,\"\\u0069d\":2}",
      "expect": "frame.json-duplicate"
    },
    {
      "name": "a duplicate in a nested object",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"goodForSeconds\":1,\"goodForSeconds\":2}}",
      "expect": "frame.json-duplicate"
    },
    {
      "name": "a duplicate in an ignored member",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"ping\",\"id\":1,\"extra\":{\"a\":1,\"a\":2}}",
      "expect": "frame.json-duplicate"
    },
    {
      "name": "a case variant of a known member",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"stopSession\",\"sessionid\":\"0f0e0d0c0b0a09080706050403020100\"}",
      "expect": "protocol.member-invalid"
    },
    {
      "name": "a case variant beside the member",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"stopSession\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"SESSIONID\":\"x\"}",
      "expect": "protocol.member-invalid"
    },
    {
      "name": "a case variant of type",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"ping\",\"id\":1,\"tYPE\":\"x\"}",
      "expect": "protocol.member-invalid"
    },
    {
      "name": "a member name outside the grammar",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"ping\",\"id\":1,\"session_id\":\"x\"}",
      "expect": "protocol.member-invalid"
    },
    {
      "name": "an unknown dollar member",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"ping\",\"id\":1,\"$schema\":\"x\"}",
      "expect": "protocol.member-invalid"
    },
    {
      "name": "a member name longer than 32 characters",
      "sender": "Host",
      "phase": "Authenticated",
      "frame": "{\"type\":\"ping\",\"id\":1,\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\":1}",
      "expect": "protocol.member-invalid"
    },
    {
      "name": "a case variant in a nested object",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"goodforseconds\":1,\"goodForSeconds\":1}}",
      "expect": "protocol.member-invalid"
    },
    {
      "name": "an unknown picture variant",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"picture\":{\"$type\":\"image\",\"uri\":\"x\"},\"line1\":{\"$type\":\"text\",\"text\":\"4:59\"},\"line2\":{\"$type\":\"text\",\"text\":\"Focus\"},\"state\":\"Playing\",\"detail\":\"Four minutes and fifty-nine seconds left.\",\"goodForSeconds\":5}}",
      "expect": "protocol.variant-unknown"
    },
    {
      "name": "an unknown line variant",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"picture\":{\"$type\":\"glyph\",\"glyph\":\"\\uE916\"},\"line1\":{\"$type\":\"time\",\"at\":1},\"line2\":{\"$type\":\"text\",\"text\":\"Focus\"},\"state\":\"Playing\",\"detail\":\"Four minutes and fifty-nine seconds left.\",\"goodForSeconds\":5}}",
      "expect": "protocol.variant-unknown"
    },
    {
      "name": "a picture without a type",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"picture\":{\"glyph\":\"\\uE916\"},\"line1\":{\"$type\":\"text\",\"text\":\"4:59\"},\"line2\":{\"$type\":\"text\",\"text\":\"Focus\"},\"state\":\"Playing\",\"detail\":\"Four minutes and fifty-nine seconds left.\",\"goodForSeconds\":5}}",
      "expect": "protocol.message-invalid"
    },
    {
      "name": "a case variant of a type value is unknown",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"picture\":{\"$type\":\"Glyph\",\"glyph\":\"\\uE916\"},\"line1\":{\"$type\":\"text\",\"text\":\"4:59\"},\"line2\":{\"$type\":\"text\",\"text\":\"Focus\"},\"state\":\"Playing\",\"detail\":\"Four minutes and fifty-nine seconds left.\",\"goodForSeconds\":5}}",
      "expect": "protocol.variant-unknown"
    },
    {
      "name": "an unknown state",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"picture\":{\"$type\":\"glyph\",\"glyph\":\"\\uE916\"},\"line1\":{\"$type\":\"text\",\"text\":\"4:59\"},\"line2\":{\"$type\":\"text\",\"text\":\"Focus\"},\"state\":\"Stopped\",\"detail\":\"Four minutes and fifty-nine seconds left.\",\"goodForSeconds\":5}}",
      "expect": "face.state-invalid"
    },
    {
      "name": "a state in the wrong case",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"picture\":{\"$type\":\"glyph\",\"glyph\":\"\\uE916\"},\"line1\":{\"$type\":\"text\",\"text\":\"4:59\"},\"line2\":{\"$type\":\"text\",\"text\":\"Focus\"},\"state\":\"playing\",\"detail\":\"Four minutes and fifty-nine seconds left.\",\"goodForSeconds\":5}}",
      "expect": "face.state-invalid"
    },
    {
      "name": "an invalid glyph",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"picture\":{\"$type\":\"glyph\",\"glyph\":\"A\"},\"line1\":{\"$type\":\"text\",\"text\":\"4:59\"},\"line2\":{\"$type\":\"text\",\"text\":\"Focus\"},\"state\":\"Playing\",\"detail\":\"Four minutes and fifty-nine seconds left.\",\"goodForSeconds\":5}}",
      "expect": "face.glyph-invalid"
    },
    {
      "name": "a lifetime of zero",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"picture\":{\"$type\":\"glyph\",\"glyph\":\"\\uE916\"},\"line1\":{\"$type\":\"text\",\"text\":\"4:59\"},\"line2\":{\"$type\":\"text\",\"text\":\"Focus\"},\"state\":\"Playing\",\"detail\":\"Four minutes and fifty-nine seconds left.\",\"goodForSeconds\":0}}",
      "expect": "face.lifetime-invalid"
    },
    {
      "name": "a lifetime over a day",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"picture\":{\"$type\":\"glyph\",\"glyph\":\"\\uE916\"},\"line1\":{\"$type\":\"text\",\"text\":\"4:59\"},\"line2\":{\"$type\":\"text\",\"text\":\"Focus\"},\"state\":\"Playing\",\"detail\":\"Four minutes and fifty-nine seconds left.\",\"goodForSeconds\":86401}}",
      "expect": "face.lifetime-invalid"
    },
    {
      "name": "a fractional lifetime",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"goodForSeconds\":1.5}}",
      "expect": "protocol.message-invalid"
    },
    {
      "name": "an integer written with an exponent",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"goodForSeconds\":1e1}}",
      "expect": "protocol.message-invalid"
    },
    {
      "name": "a string lifetime",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"goodForSeconds\":\"5\"}}",
      "expect": "protocol.message-invalid"
    },
    {
      "name": "a face without a lifetime",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"setFace\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"face\":{\"state\":\"On\"}}",
      "expect": "protocol.message-invalid"
    },
    {
      "name": "an unknown failure",
      "sender": "Companion",
      "phase": "Authenticated",
      "frame": "{\"type\":\"fail\",\"sessionId\":\"0f0e0d0c0b0a09080706050403020100\",\"failure\":\"Timeout\"}",
      "expect": "face.failure-invalid"
    },
    {
      "name": "a capability-gated failure without its capability",
      "sender": "Companion",
