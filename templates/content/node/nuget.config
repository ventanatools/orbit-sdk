<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
<!--#if (hasPackageSource)-->
    <!-- The extension packages, from the folder the tool prepared. -->
    <add key="extension-packages" value="TEMPLATE_PACKAGE_SOURCE" />
<!--#else-->
    <!-- The extension packages, from the per-user folder the tool's new command fills. They are not published on
         nuget.org, and the mapping below never lets nuget.org serve a package with their names: restore fails
         until that folder exists. Create projects with the tool's new command, or point this at another folder. -->
    <add key="extension-packages" value="%LOCALAPPDATA%\VentanaTools\packages\0.0.0-template-version" />
<!--#endif-->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- The extension packages come only from their folder; everything else from nuget.org. -->
    <packageSource key="extension-packages">
      <package pattern="VentanaTools.Orbit.Extensions*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
