<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
<!--#if (hasPackageSource)-->
    <!-- The extension packages, from the folder the tool prepared. -->
    <add key="extension-packages" value="TEMPLATE_PACKAGE_SOURCE" />
<!--#endif-->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
<!--#if (hasPackageSource)-->
  <packageSourceMapping>
    <!-- The extension packages come only from their folder; everything else from nuget.org. -->
    <packageSource key="extension-packages">
      <package pattern="VentanaTools.Orbit.Extensions*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
<!--#else-->
  <!-- The VentanaTools.Orbit.Extensions packages are not published on nuget.org yet. Create projects with the
       tool's new command, which passes its package folder, or add that folder above with a packageSourceMapping. -->
<!--#endif-->
</configuration>
